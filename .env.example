# Pawn.Ink environment — placeholders only. NEVER commit a real .env.
# Development: `scripts/dev.sh env` writes .env from this file with random
# secrets and the disposable Compose service ports (deployments/docker-compose.dev.yml).
# Production: /etc/pawn-ink/pawn-ink.env, mode 0600, owned by root:pawn-ink.

APP_ENV=development
APP_NAME=Pawn.Ink
APP_BASE_URL=http://localhost:14021
HTTP_ADDR=127.0.0.1:14021
TRUSTED_PROXY_CIDRS=

# Collar (embedded). The DSNs have no default database: every query is qualified.
COLLAR_CONFIG=./collar.yaml
COLLAR_ADDR=127.0.0.1:14021
COLLAR_DSN=pawn_app:CHANGE_ME@tcp(127.0.0.1:13306)/?parseTime=true&loc=UTC
COLLAR_ADMIN_DSN=pawn_migrator:CHANGE_ME@tcp(127.0.0.1:13306)/?parseTime=true&loc=UTC
COLLAR_AUTO_MIGRATE=false
COLLAR_GLOBAL_REGISTRATION=false
COLLAR_ACCESS_TTL=15m
COLLAR_REFRESH_TTL=720h
COLLAR_TRUST_PROXY=false
COLLAR_ADMIN_DIR=
COLLAR_CORS_ORIGINS=http://localhost:14021
COLLAR_JWT_SECRET=CHANGE_ME_LONG_RANDOM_HEX
COLLAR_LOG_FORMAT=json

# Pawn.Ink databases (expanded into collar.yaml).
APP_DATABASE=pawn_ink
COLLAR_SYSTEM_DATABASE=pawn_ink_collar

# Redis: persistent analytics/view buffer (AOF + noeviction), flushed every 120s.
REDIS_URL=redis://127.0.0.1:16379/0
REDIS_KEY_PREFIX=pawn:dev:analytics
ANALYTICS_FLUSH_INTERVAL=120s

# Secrets: at least 32 random bytes each; TOKEN_ENCRYPTION_KEY is exactly 32
# bytes as 64 hex characters (openssl rand -hex 32).
SESSION_HMAC_KEY=CHANGE_ME_LONG_RANDOM_HEX
CSRF_HMAC_KEY=CHANGE_ME_LONG_RANDOM_HEX
TOKEN_ENCRYPTION_KEY=CHANGE_ME_32_BYTE_SECRET
RANKING_HMAC_KEY=CHANGE_ME_LONG_RANDOM_HEX
ANALYTICS_HMAC_KEY=CHANGE_ME_LONG_RANDOM_HEX

OWNER_BOOTSTRAP_EMAIL=owner@example.invalid

# Local development uses Mailpit (UI on http://127.0.0.1:18025).
SMTP_HOST=127.0.0.1
SMTP_PORT=11025
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=no-reply@example.invalid

# Local development uses MinIO with Collar storage configuration.
OBJECT_STORE_KIND=s3
S3_ENDPOINT=http://127.0.0.1:19000
S3_BUCKET=pawn-ink-dev
S3_ACCESS_KEY=
S3_SECRET_KEY=
ASSET_ORIGINS=

PATREON_ENABLED=false
PATREON_CLIENT_ID=
PATREON_CLIENT_SECRET=
PATREON_REDIRECT_URL=http://localhost:14021/api/v1/pawn/x/patreon/callback
PATREON_CREATOR_CAMPAIGN_ID=
MAX_EARLY_DAYS=30
ANALYTICS_ENABLED=true
# Rejected at boot unless APP_ENV=development and HTTP_ADDR is loopback.
ALLOW_TEST_ENTITLEMENTS=false

# Development only: serve the Parcel output from disk (make dev-web rebuilds it).
WEB_DIST_DIR=
CSP_REPORT_ONLY=false
LOG_LEVEL=info
