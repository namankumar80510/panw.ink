# Pawn.Ink server block for an EXISTING Nginx installation.
# Review, adapt the certificate paths and the approved loopback port, then
# place it in sites-available/ and enable it. Run `nginx -t` before an
# authorized reload. Do not edit nginx.conf or other sites.
#
# Upstream: the systemd-managed Go API (pawn-ink.service) on loopback only.
# Set TRUSTED_PROXY_CIDRS=127.0.0.1/32 in /etc/pawn-ink/pawn-ink.env so the
# app trusts X-Forwarded-For from this proxy only.

upstream pawn_ink_api {
    server 127.0.0.1:14021;   # replace with the approved, verified-free port
    keepalive 16;
}

server {
    listen 80;
    listen [::]:80;
    server_name pawn.ink;
    return 301 https://pawn.ink$request_uri;
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name pawn.ink;

    ssl_certificate     /etc/letsencrypt/live/pawn.ink/fullchain.pem;   # adapt
    ssl_certificate_key /etc/letsencrypt/live/pawn.ink/privkey.pem;     # adapt

    client_max_body_size 6m;          # 5 MB image uploads + overhead
    proxy_read_timeout 15s;           # API default (§14.2)
    proxy_send_timeout 15s;

    gzip on;
    gzip_types application/json application/javascript text/css image/svg+xml;
    gzip_min_length 1024;

    # Security headers are set by the application; do not duplicate them here.

    location / {
        proxy_pass http://pawn_ink_api;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;   # overwrite, never append client-supplied values
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Collar realtime (Server-Sent Events): no buffering, long reads.
    location ~ ^/api/v1/[^/]+/realtime$ {
        proxy_pass http://pawn_ink_api;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_buffering off;
        proxy_read_timeout 1h;
    }
}
